# PostgREST（nowplayingat スキーマ）— Cloudflare Access の背後
POSTGREST_URL=https://postgrest.example.com
CF_CLIENT_ID=
CF_CLIENT_SECRET=

# poller（bsky_NowPlayingAt_server）と共有する /api/auto-post, /api/cache の認証シークレット
NOWPLAYINGAT_SHARED_SECRET=

# OAuth confidential client signing key (private JWK).
# kid は static/client-metadata.json の jwks と一致させる。scripts/gen-oauth-key.mjs で生成。
OAUTH_PRIVATE_KEY_JWK=

# 外部 API
LASTFM_API_KEY=
LASTFM_API_SECRET=
DISCOGS_TOKEN=
YOUTUBE_API_KEY=
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=
